# Copy these values to .env. Do not use an Admin API token in a browser app.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
VITE_SHOPIFY_API_VERSION=2026-10
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_headless_customer_account_client_id
VITE_SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://your-storefront.example.com/account/callback
VITE_SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URI=https://your-storefront.example.com/
